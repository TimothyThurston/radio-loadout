# Allowlist only build inputs. Backups, secrets, caches and test output stay out.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!README.md
!LICENSE
!COPYRIGHT
!deploy/
!deploy/requirements-build.lock
!deploy/requirements-runtime.lock
!src/
!src/radio_loadout/
!src/radio_loadout/*.py
!src/radio_loadout/third_party_notices/
!src/radio_loadout/third_party_notices/v1/
!src/radio_loadout/third_party_notices/v1/manifest.json
!src/radio_loadout/third_party_notices/v1/README.md
!src/radio_loadout/third_party_notices/v1/*/
!src/radio_loadout/third_party_notices/v1/*/*.txt
!src/radio_loadout/exporters/
!src/radio_loadout/exporters/*.py
!src/radio_loadout/importers/
!src/radio_loadout/importers/*.py
!src/radio_loadout/web/
!src/radio_loadout/web/*.py
!src/radio_loadout/web/static/
!src/radio_loadout/web/static/backup-format.js
!src/radio_loadout/web/static/builder.js
!src/radio_loadout/web/static/settings-plan.js
!src/radio_loadout/web/static/radio-settings.js
!src/radio_loadout/web/static/styles.css
!src/radio_loadout/web/static/input-limits.json
!src/radio_loadout/web/templates/
!src/radio_loadout/web/templates/index.html
!src/radio_loadout/web/templates/builder.html
!src/radio_loadout/web/templates/radio-settings.html
